# i-um local environment example
#
# Copy this file to .env at the project root and fill real secret values locally.
# Do not commit .env. It is ignored by git.
#
# Worktrees should symlink their .env back to the project root .env instead of copying it:
#   cd .worktrees/<worktree-name>
#   ln -s ../../.env .env
#
# The Go API does not auto-load .env files. Load it in your shell before running API commands:
#   set -a; source .env; set +a

# -----------------------------------------------------------------------------
# API server / local DB
# -----------------------------------------------------------------------------

# Local docker-compose PostgreSQL URL.
DATABASE_URL=postgres://ium:ium@localhost:5432/ium?sslmode=disable

# Local API port. Cloud Run provides PORT in deployed environments.
PORT=8080

# JWT/session signing secret. Use a long random value locally and a Secret Manager
# value for staging/prod.
AUTH_TOKEN_SECRET=replace-with-long-random-secret

# Local/internal smoke only. Keep false or unset on public staging/prod.
AUTH_ALLOW_DEV_OAUTH=true

# Apple OAuth audience for native Sign in with Apple.
APPLE_CLIENT_ID=com.twotwobread.ium.staging

# Server-side Google API key used for Places and Routes. If you intentionally
# split keys later, GOOGLE_PLACES_API_KEY / GOOGLE_ROUTES_API_KEY are supported
# as runtime overrides but are intentionally omitted here to keep local env small.
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Shared GCS bucket/signing config used by server-side file features such as
# boarding passes and expense receipts.
GCS_BUCKET=
GCS_SIGNING_ACCESS_ID=
GCS_SIGNING_PRIVATE_KEY=

# Server-side expense receipt extraction. OPENAI_API_KEY is required only when
# testing receipt extraction locally.
OPENAI_API_KEY=
RECEIPT_OPENAI_MODEL=gpt-4o-mini

# Public invite link domain/base URL. The API returns ${INVITE_BASE_URL}/invite/{token}.
INVITE_BASE_URL=https://invite.i-um.app
INVITE_APP_SCHEME=ium

# Store fallback targets used by the web /invite/{token} page when the app is not installed.
INVITE_APP_STORE_URL=https://apps.apple.com/app/replace-with-app-id
INVITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.twotwobread.ium

# -----------------------------------------------------------------------------
# Mobile app / Expo public env
# -----------------------------------------------------------------------------

# iOS Simulator can use localhost. Android Emulator usually needs http://10.0.2.2:8080.
# Physical devices need the host machine LAN URL, e.g. http://192.168.x.x:8080.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Local/internal smoke only. Set false for real Apple/Kakao provider login builds.
EXPO_PUBLIC_AUTH_DEV_MODE=true

# Required only for real Kakao native login builds. Do not include the kakao prefix;
# app config derives the native URL scheme as kakao${EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY}.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key

# Android native MapView uses Google Maps SDK. This is public build-time config,
# so keep it separate from the server-side GOOGLE_MAPS_API_KEY.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=replace-with-google-maps-android-sdk-api-key

# Host part of INVITE_BASE_URL used for iOS associated domains and Android app links.
EXPO_PUBLIC_INVITE_LINK_HOST=invite.i-um.app

# Set by EAS during preview builds; normally not needed for local .env.
# EAS_BUILD_PROFILE=preview
