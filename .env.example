# i-um local environment example
#
# Copy this file to .env at the project root and fill real secret values locally.
# Do not commit .env. It is ignored by git.
#
# Worktrees should symlink their .env back to the project root .env instead of copying it:
#   cd .worktrees/<worktree-name>
#   ln -s ../../.env .env
#
# The Go API does not auto-load .env files. Load it in your shell before running API commands:
#   set -a; source .env; set +a

# -----------------------------------------------------------------------------
# API server / local DB
# -----------------------------------------------------------------------------

# Local docker-compose PostgreSQL URL.
DATABASE_URL=postgres://ium:ium@localhost:5432/ium?sslmode=disable

# Local API port. Cloud Run provides PORT in deployed environments.
PORT=8080

# JWT/session signing secret. Use a long random value locally and a Secret Manager
# value for staging/prod.
AUTH_TOKEN_SECRET=replace-with-long-random-secret

# Local/internal smoke only. Keep false or unset on public staging/prod.
AUTH_ALLOW_DEV_OAUTH=true

# Apple OAuth audience. APPLE_CLIENT_ID is preferred; APPLE_BUNDLE_ID is a fallback
# supported by the API server.
APPLE_CLIENT_ID=com.twotwobread.ium.staging
# APPLE_BUNDLE_ID=com.twotwobread.ium.staging

# Server-side Google Places API key. Restrict the key to Places API only.
# Do not put this value in mobile EXPO_PUBLIC_* env vars.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key

# -----------------------------------------------------------------------------
# Mobile app / Expo public env
# -----------------------------------------------------------------------------

# iOS Simulator can use localhost. Android Emulator usually needs http://10.0.2.2:8080.
# Physical devices need the host machine LAN URL, e.g. http://192.168.x.x:8080.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Local/internal smoke only. Set false for real Apple/Kakao provider login builds.
EXPO_PUBLIC_AUTH_DEV_MODE=true

# Required only for real Kakao native login builds. Do not include the kakao prefix;
# app config derives the native URL scheme as kakao${EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY}.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key

# Set by EAS during preview builds; normally not needed for local .env.
# EAS_BUILD_PROFILE=preview
