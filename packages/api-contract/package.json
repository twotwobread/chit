{
  "name": "@i-um/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./gen/ts/index.ts",
  "types": "./gen/ts/index.ts",
  "exports": {
    ".": {
      "types": "./gen/ts/index.ts",
      "default": "./gen/ts/index.ts"
    }
  },
  "scripts": {
    "generate": "pnpm run generate:go && pnpm run generate:ts",
    "generate:go": "go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.4.1 -generate types,chi-server -package openapi -o ../../apps/api/internal/openapi/server.gen.go openapi.yaml",
    "generate:ts": "openapi --input openapi.yaml --output gen/ts --client fetch --useUnionTypes"
  },
  "devDependencies": {
    "openapi-typescript-codegen": "0.29.0"
  }
}
