{
  "expo": {
    "name": "i-um",
    "slug": "i-um",
    "scheme": "ium",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "com.twotwobread.ium.staging",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.twotwobread.ium"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cb10661-9fbf-4f80-8467-663373d9c1b3"
      }
    },
    "owner": "nikanikanika"
  }
}
