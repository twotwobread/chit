{
  "name": "i-um",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "generate": "pnpm --filter @i-um/api-contract generate && pnpm --filter @i-um/api generate",
    "dev:api": "pnpm --filter @i-um/api dev",
    "dev:mobile": "pnpm --filter @i-um/mobile start",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @i-um/api db:migrate",
    "db:rollback": "pnpm --filter @i-um/api db:rollback",
    "db:status": "pnpm --filter @i-um/api db:status",
    "deploy": "node scripts/deploy.mjs",
    "deploy:stage": "node scripts/deploy.mjs stage",
    "deploy:notifications": "node scripts/deploy.mjs stage --only notifications --platform none",
    "test:deploy": "node --test scripts/*.test.mjs",
    "verify:generated": "tmp=$(mktemp) && find apps/api/internal/openapi apps/api/internal/db packages/api-contract/gen/ts -type f | sort | xargs shasum > \"$tmp\" && pnpm generate && find apps/api/internal/openapi apps/api/internal/db packages/api-contract/gen/ts -type f | sort | xargs shasum | diff -u \"$tmp\" -",
    "harness:sync": "node .harness/scripts/sync-adapters.mjs",
    "harness:validate": "node .harness/scripts/validate-harness.mjs",
    "harness:evaluate-provider": "node .harness/scripts/evaluate-provider-policy.mjs",
    "harness:record-run": "node .harness/scripts/record-run-summary.mjs",
    "harness:check-bugfix-scenario": "node .harness/scripts/check-bugfix-scenario-coverage.mjs",
    "harness:check-worktree-isolation": "node .harness/scripts/check-worktree-isolation.mjs --repo-root .",
    "lint": "pnpm --filter @i-um/api lint && pnpm --filter @i-um/mobile lint",
    "format": "pnpm --filter @i-um/api format && pnpm --filter @i-um/mobile format",
    "format:check": "pnpm --filter @i-um/api format:check && pnpm --filter @i-um/mobile format:check",
    "verify": "pnpm verify:generated && pnpm test:deploy && pnpm lint && pnpm format:check && pnpm --filter @i-um/api test && pnpm --filter @i-um/api build && pnpm --filter @i-um/mobile test && pnpm --filter @i-um/mobile typecheck"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
