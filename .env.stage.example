# i-um staging deployment environment example
#
# Copy this file to .env.stage and replace placeholder secret values locally:
#   cp .env.stage.example .env.stage
#
# Do not commit .env.stage. The deploy script loads this file locally and syncs
# server-side secrets to GCP Secret Manager / Cloud Run and mobile public config
# to the EAS preview environment. Values marked "secret" must not be pasted in
# chat, issues, git, or deploy logs.

# -----------------------------------------------------------------------------
# Deploy target defaults
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=i-um-488511
GCP_REGION=asia-northeast3
CLOUD_BUILD_REGION=asia-northeast3
CLOUD_RUN_SERVICE=i-um-api-staging
CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT=i-um-api-staging-run@i-um-488511.iam.gserviceaccount.com
ARTIFACT_REPOSITORY=i-um-staging
IMAGE_NAME=api
CLOUD_BUILD_TRIGGER=i-um-api-staging-deploy
DEPLOY_BRANCH=develop

# -----------------------------------------------------------------------------
# GCP Secret Manager secret names
# -----------------------------------------------------------------------------
DATABASE_URL_SECRET_NAME=i-um-staging-database-url
AUTH_TOKEN_SECRET_NAME=i-um-staging-auth-token-secret
GOOGLE_MAPS_API_KEY_SECRET_NAME=i-um-staging-google-maps-api-key
GCS_SIGNING_PRIVATE_KEY_SECRET_NAME=i-um-staging-gcs-signing-private-key
OPENAI_API_KEY_SECRET_NAME=i-um-staging-openai-api-key
EXPO_PUSH_ACCESS_TOKEN_SECRET_NAME=i-um-staging-expo-push-access-token

# -----------------------------------------------------------------------------
# API runtime secrets synced to Secret Manager (replace locally)
# -----------------------------------------------------------------------------
# Cloud SQL Unix socket DATABASE_URL for Cloud Run runtime, or another PostgreSQL
# URL for non-Cloud Run environments.
DATABASE_URL=replace-with-postgresql-url

# Long random JWT/session signing secret. Generate locally, for example:
#   openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-long-random-secret

# Server-side Google API key used for Places and Routes. If you intentionally
# split keys later, GOOGLE_PLACES_API_KEY / GOOGLE_ROUTES_API_KEY are supported
# as runtime overrides but are intentionally omitted here to keep staging env small.
GOOGLE_MAPS_API_KEY=replace-with-google-maps-api-key

# Private key PEM for the service account used to sign short-lived GCS download URLs.
# Keep the literal \n escapes if storing it on one line.
GCS_SIGNING_PRIVATE_KEY=replace-with-service-account-private-key-pem

# OpenAI API key used by server-side expense receipt extraction.
OPENAI_API_KEY=replace-with-openai-api-key

# Optional Expo push access token. Leave blank unless Expo push security is enabled
# for the project; if set, the deploy script syncs it to Secret Manager and only
# mounts it into the notification worker job.
EXPO_PUSH_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# API runtime non-secret config for real Apple/Kakao login
# -----------------------------------------------------------------------------
# Keep false for real provider login. The deploy script rejects true here.
AUTH_ALLOW_DEV_OAUTH=false

# Native Sign in with Apple audience for the staging iOS app.
APPLE_CLIENT_ID=com.twotwobread.ium.staging

# Shared private object storage used by server-side file features such as
# boarding passes and expense receipts. Staging uses GCS with a canonical bucket
# env plus GCS service-account signing values. The deploy target must grant the
# Cloud Run runtime service account object read/write/delete access.
OBJECT_STORAGE_PROVIDER=gcs
OBJECT_STORAGE_BUCKET=i-um-storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
GCS_SIGNING_ACCESS_ID=replace-with-signing-service-account-email

# Server-side receipt extraction model.
RECEIPT_OPENAI_MODEL=gpt-4o-mini

# Invite/deep-link config returned by the API.
# Leave INVITE_BASE_URL blank unless you own and have configured a custom domain.
# When blank, the deploy script uses the deployed Cloud Run URL for demo invites.
INVITE_BASE_URL=
INVITE_APP_SCHEME=ium
# Apple app site association appIDs use TEAM_ID.bundleIdentifier.
# Example: ABCDE12345.com.twotwobread.ium.staging
INVITE_IOS_APP_IDS=
INVITE_ANDROID_PACKAGE_NAME=com.twotwobread.ium
# Comma-separated SHA-256 fingerprints for Android App Links.
INVITE_ANDROID_SHA256_CERT_FINGERPRINTS=
INVITE_APP_STORE_URL=https://apps.apple.com/app/replace-with-app-id
INVITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.twotwobread.ium

# -----------------------------------------------------------------------------
# EAS preview/internal mobile build config
# -----------------------------------------------------------------------------
EAS_PROJECT_DIR=apps/mobile
EAS_ENVIRONMENT=preview
EAS_BUILD_PROFILE=preview

# The deploy script sets EXPO_PUBLIC_API_BASE_URL to the deployed Cloud Run URL
# after API deploy/smoke. Set this only when running --only mobile/eas-env
# against a known API URL without querying Cloud Run.
# EXPO_PUBLIC_API_BASE_URL=https://replace-with-cloud-run-url

# Keep false for real Apple/Kakao provider login. The deploy script rejects true.
EXPO_PUBLIC_AUTH_DEV_MODE=false

# Kakao native app key for the staging iOS/Android app. Do not include "kakao";
# app.config.ts derives the native URL scheme as kakao${EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY}.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key

# Android native MapView uses Google Maps SDK. This is public build-time config,
# so keep it separate from the server-side GOOGLE_MAPS_API_KEY.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=replace-with-google-maps-android-sdk-api-key

# Host part of INVITE_BASE_URL for associated domains / app links.
# Leave blank to disable native HTTPS auto-open until you own/configure a domain.
EXPO_PUBLIC_INVITE_LINK_HOST=

# -----------------------------------------------------------------------------
# Notification worker Cloud Run Job / Cloud Scheduler config
# -----------------------------------------------------------------------------
# pnpm deploy stage creates/updates this Cloud Run Job using the same API image
# and command override /app/notification-worker.
NOTIFICATION_WORKER_JOB=i-um-notification-worker-staging
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_MAX_ATTEMPTS=8
NOTIFICATION_WORKER_STALE_RUNNING_MINUTES=10
NOTIFICATION_WORKER_MAX_BATCHES=20
# EXPO_PUSH_ENDPOINT=

# pnpm deploy stage creates/updates this Scheduler job to invoke the worker job.
NOTIFICATION_WORKER_SCHEDULER_JOB=i-um-notification-worker-staging-every-minute
NOTIFICATION_WORKER_SCHEDULE=* * * * *
NOTIFICATION_WORKER_TIME_ZONE=Asia/Seoul
NOTIFICATION_WORKER_SCHEDULER_SERVICE_ACCOUNT=i-um-notify-scheduler@i-um-488511.iam.gserviceaccount.com
