# i-um staging deployment environment example
#
# Copy this file to .env.stage and replace placeholder secret values locally:
#   cp .env.stage.example .env.stage
#
# Do not commit .env.stage. The deploy script loads this file locally and syncs
# server-side secrets to GCP Secret Manager / Cloud Run and mobile public config
# to the EAS preview environment. Values marked "secret" must not be pasted in
# chat, issues, git, or deploy logs.

# -----------------------------------------------------------------------------
# Deploy target defaults
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=i-um-488511
GCP_REGION=asia-northeast3
CLOUD_BUILD_REGION=asia-northeast3
CLOUD_RUN_SERVICE=i-um-api-staging
CLOUD_RUN_RUNTIME_SERVICE_ACCOUNT=i-um-api-staging-run@i-um-488511.iam.gserviceaccount.com
CLOUD_BUILD_TRIGGER=i-um-api-staging-deploy
DEPLOY_BRANCH=develop

# -----------------------------------------------------------------------------
# GCP Secret Manager secret names
# -----------------------------------------------------------------------------
DATABASE_URL_SECRET_NAME=i-um-staging-database-url
AUTH_TOKEN_SECRET_NAME=i-um-staging-auth-token-secret
GOOGLE_PLACES_API_KEY_SECRET_NAME=i-um-staging-google-places-api-key
GOOGLE_ROUTES_API_KEY_SECRET_NAME=i-um-staging-google-routes-api-key
BOARDING_PASS_GCS_SIGNING_PRIVATE_KEY_SECRET_NAME=i-um-staging-boarding-pass-gcs-signing-private-key

# -----------------------------------------------------------------------------
# API runtime secrets synced to Secret Manager (replace locally)
# -----------------------------------------------------------------------------
# Neon pooled DATABASE_URL for Cloud Run runtime. The deploy script derives a
# direct Neon URL from this value for goose migrations by removing "-pooler.".
DATABASE_URL=replace-with-neon-pooled-postgresql-url

# Long random JWT/session signing secret. Generate locally, for example:
#   openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-long-random-secret

# Server-side Google Places API key. Prefer a server-restricted key in production.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key

# Server-side Google Routes API key. If you currently only have a maps key,
# put the same value here after enabling/restricting Routes API appropriately.
GOOGLE_ROUTES_API_KEY=replace-with-google-routes-api-key

# Private key PEM for the service account used to sign short-lived boarding pass
# download URLs. Keep the literal \n escapes if storing it on one line.
BOARDING_PASS_GCS_SIGNING_PRIVATE_KEY=replace-with-service-account-private-key-pem

# -----------------------------------------------------------------------------
# API runtime non-secret config for real Apple/Kakao login
# -----------------------------------------------------------------------------
# Keep false for real provider login. The deploy script rejects true here.
AUTH_ALLOW_DEV_OAUTH=false

# Native Sign in with Apple audience for the staging iOS app.
APPLE_BUNDLE_ID=com.twotwobread.ium.staging
# APPLE_CLIENT_ID=

# Private GCS bucket for boarding pass images. The deploy target must grant the
# Cloud Run runtime service account object read/write/delete access to this bucket.
BOARDING_PASS_GCS_BUCKET=i-um-storage

# Service account email whose private key above signs boarding pass download URLs.
BOARDING_PASS_GCS_SIGNING_ACCESS_ID=replace-with-signing-service-account-email

# Invite/deep-link config returned by the API.
# Leave INVITE_BASE_URL blank unless you own and have configured a custom domain.
# When blank, the deploy script uses the deployed Cloud Run URL for demo invites.
INVITE_BASE_URL=
INVITE_APP_SCHEME=ium
# Apple app site association appIDs use TEAM_ID.bundleIdentifier.
# Example: ABCDE12345.com.twotwobread.ium.staging
INVITE_IOS_APP_IDS=
INVITE_ANDROID_PACKAGE_NAME=com.twotwobread.ium
# Comma-separated SHA-256 fingerprints for Android App Links.
INVITE_ANDROID_SHA256_CERT_FINGERPRINTS=
INVITE_APP_STORE_URL=https://apps.apple.com/app/replace-with-app-id
INVITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.twotwobread.ium

# -----------------------------------------------------------------------------
# EAS preview/internal mobile build config
# -----------------------------------------------------------------------------
EAS_PROJECT_DIR=apps/mobile
EAS_ENVIRONMENT=preview
EAS_BUILD_PROFILE=preview

# The deploy script sets EXPO_PUBLIC_API_BASE_URL to the deployed Cloud Run URL
# after API deploy/smoke. Set this only when running --only mobile/eas-env
# against a known API URL without querying Cloud Run.
# EXPO_PUBLIC_API_BASE_URL=https://replace-with-cloud-run-url

# Keep false for real Apple/Kakao provider login. The deploy script rejects true.
EXPO_PUBLIC_AUTH_DEV_MODE=false

# Kakao native app key for the staging iOS/Android app. Do not include "kakao";
# app.config.ts derives the native URL scheme as kakao${EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY}.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key

# Android native MapView uses Google Maps SDK. Set this for Android internal builds.
# If reusing GOOGLE_PLACES_API_KEY/GOOGLE_ROUTES_API_KEY, the same key must also
# allow Maps SDK for Android. Prefer Android app restriction with package/SHA-1.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=replace-with-google-maps-android-sdk-api-key

# Host part of INVITE_BASE_URL for associated domains / app links.
# Leave blank to disable native HTTPS auto-open until you own/configure a domain.
EXPO_PUBLIC_INVITE_LINK_HOST=
